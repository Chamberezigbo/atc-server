PORT=4000
DATABASE_URL=mysql://atclean_user:password@localhost:3306/atclean_db
JWT_SECRET=replace-with-a-long-random-string
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
# Used only by POST /api/auth/recover-password — a separate secret from the
# admin's login password, for resetting it back to SEED_ADMIN_PASSWORD if
# they get locked out. Never exposed to the browser. Generate a long random
# value, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_RECOVERY_SECRET=replace-with-a-long-random-string
RESEND_API_KEY=
# Until a real domain is verified in Resend, leave this unset to use their
# sandbox sender (onboarding@resend.dev) — it can only email your own
# Resend account address until you verify a domain.
RESEND_FROM_EMAIL="ATClean <onboarding@resend.dev>"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
